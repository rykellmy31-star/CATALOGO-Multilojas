# ============================================
# CATÁLOGOS SAAS - VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para .dev.vars (Cloudflare) ou .env (local)
# NUNCA comite chaves reais no GitHub! Os campos sensíveis devem ficar vazios neste exemplo.
# No Worker publicado, utilizar Secrets via Cloudflare; não copiar valores de teste.
# D1 e R2 são bindings do Worker: não use chaves de acesso R2 para operações normais.

# --- CLOUDFLARE ---
CLOUDFLARE_ACCOUNT_ID=seu_account_id_aqui
CLOUDFLARE_API_TOKEN=seu_api_token_aqui
CLOUDFLARE_ZONE_ID=seu_zone_id_aqui

# --- BANCO D1 ---
# Criado via: wrangler d1 create catalogos_db
D1_DATABASE_ID=xxxx-xxxx-xxxx-xxxx

# --- STORAGE R2 ---
R2_BUCKET_NAME=catalogos-storage
R2_PUBLIC_BUCKET=catalogos-public
R2_PUBLIC_URL=https://pub-xxx.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- AUTENTICAÇÃO & SEGURANÇA ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SESSION_SECRET=

# --- INTELIGÊNCIA ARTIFICIAL ---
# Provedor: openai | anthropic | google
AI_PROVIDER=openai
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Limites de IA por plano
AI_DAILY_LIMIT_FREE=10
AI_DAILY_LIMIT_PRO=100
AI_MONTHLY_LIMIT_FREE=50
AI_COST_PER_IMAGE=0.04
AI_COST_PER_DESCRIPTION=0.01

# --- PLATAFORMA ---
PLATFORM_NAME=Catálogos Pro
PLATFORM_URL=https://seudominio.com
SUPER_ADMIN_SETUP_TOKEN=
FOOTER_TEXT=Sistema desenvolvido por Catálogos Pro
SUPPORT_EMAIL=suporte@seudominio.com

# --- WHATSAPP ---
WHATSAPP_DEFAULT_MESSAGE=Olá! Tenho interesse no produto:

# --- ANALYTICS ---
ENABLE_ANALYTICS=true

# --- AMBIENTE ---
NODE_ENV=production
ENVIRONMENT=production
FRONTEND_URL=https://seudominio.com
API_URL=https://api.seudominio.com

# --- DESENVOLVIMENTO ---
VITE_API_URL=http://localhost:8787
VITE_PLATFORM_NAME=Catálogos Pro
